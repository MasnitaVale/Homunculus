// Cloudflare Workers settings: serve the built site from dist/ as static files.
{
  "name": "homunculus",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "mirror.valemasnita.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
